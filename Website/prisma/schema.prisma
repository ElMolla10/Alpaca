// This is your Prisma schema file.
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// NextAuth Adapter models
model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Custom User model for credentials auth
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
}

model InferenceEvent {
  id           BigInt   @id @default(autoincrement())
  ts           DateTime
  modelId      String   @map("model_id")
  modelVersion String   @map("model_version")
  requestId    String?  @unique @map("request_id")
  predType     String   @map("pred_type")
  latencyMs    Int?     @map("latency_ms")
  featuresJson Json     @map("features_json")
  yPredNum     Float?   @map("y_pred_num")
  yPredText    String?  @map("y_pred_text")
  segmentJson  Json     @map("segment_json")
  createdAt    DateTime @default(now()) @map("created_at")

  labels LabelEvent[]

  @@index([ts])
  @@index([modelId, modelVersion, ts])
  @@map("inference_events")
}

model LabelEvent {
  id          BigInt   @id @default(autoincrement())
  ts          DateTime
  requestId   String   @unique @map("request_id")
  yTrueNum    Float?   @map("y_true_num")
  yTrueText   String?  @map("y_true_text")
  labelType   String   @default("regression") @map("label_type")
  extraJson   Json     @map("extra_json")
  createdAt   DateTime @default(now()) @map("created_at")

  inference InferenceEvent @relation(fields: [requestId], references: [requestId], onDelete: Cascade, onUpdate: Cascade)

  @@index([ts])
  @@map("label_events")
}
